<UserControl x:Class="Elementary.ElementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Elementary"
             Width="70" Height="78">
    <UserControl.Resources>
        <local:CategoryToColorConverter x:Key="CategoryToColorConverter"/>
    </UserControl.Resources>
    <Border BorderBrush="Black" BorderThickness="1" Padding="1" Margin="1" 
            Background="{Binding CategoryColor}">
        <Grid>
            <Grid.RowDefinitions>                
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>                
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>                
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock FontSize="10" HorizontalAlignment="Left">
                    <Run Text="{Binding AtomicWeight}" />
                </TextBlock>
                <TextBlock Text="   "/>
                <TextBlock FontSize="12" FontWeight="Bold" HorizontalAlignment="Right">
                    <Run Text="{Binding AtomicNumber}" />
                </TextBlock>
            </StackPanel>
            <TextBlock Text="{Binding Symbol}" FontWeight="Bold" FontSize="18" Grid.Row="1" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Name}" FontSize="10" Grid.Row="2" HorizontalAlignment="Left"/>                       
            <TextBlock Text="{Binding MeltingPoint}" FontSize="10" Grid.Row="3" HorizontalAlignment="Left"/>
            <StackPanel/>
        </Grid>
    </Border>
</UserControl>
